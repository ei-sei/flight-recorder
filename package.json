{
  "name": "flight-recorder",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "description": "Practise job interviews on webcam, fully on your own machine.",
  "author": "ei-sei",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "node scripts/start.js",
    "dev": "node scripts/start.js --dev",
    "test": "node --test src/js/*.test.js electron/*.test.js scripts/*.test.js",
    "build:helper": "node scripts/build-helper.js",
    "dist": "electron-builder --publish never",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.e2e.js"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "playwright-core": "1.63.0"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
