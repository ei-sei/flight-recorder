{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "flight-recorder",
  "version": "0.1.0",
  "identifier": "com.flightrecorder.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "flight-recorder",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$VIDEO/flight-recorder/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFCMDA1RjMyNjUzQjY1M0IKUldRN1pUdGxNbDhBcThnU29tQTcyb1NqNTR5K2JuWHFSVFFQOGJkVTgyM1dlalZkbXVlczJwZlAK",
      "endpoints": ["https://github.com/ei-sei/flight-recorder/releases/latest/download/latest.json"]
    }
  }
}
